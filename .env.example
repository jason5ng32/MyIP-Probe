# MyIP-Probe environment template. Copy to .env and fill in; .env is never committed.

# ── Cloudflare account ──────────────────────────────────────────────
# Account the Worker deploys to. Wrangler reads this variable itself, so a
# machine signed in to several accounts always deploys to this one.
CLOUDFLARE_ACCOUNT_ID=

# ── Test deployment (pnpm deploy:dev) ───────────────────────────────
# Name of the test Worker; keep it apart from any production Worker.
PROBE_DEV_WORKER_NAME=myip-probe-dev
# Zone the test hostnames belong to, e.g. example.com
PROBE_DEV_ZONE=
# Main test hostname, answering over IPv4 and IPv6, e.g. probe-dev.example.com.
# Deployed as a Custom Domain: Cloudflare creates its DNS record and
# certificate, so it must not have a DNS record beforehand.
PROBE_DEV_HOST=

# ── Runtime config (passed to the Worker as variables) ──────────────
# Hostname serving the page over IPv4 and IPv6, so the IPv4 / IPv6 hosts below
# accept its lookups. pnpm deploy:dev fills it from PROBE_DEV_HOST.
PROBE_HOST=
# Hostname reachable over IPv4 only: a DNS-only A record pointing at a
# Cloudflare IPv4 address, e.g. probe-dev-4.example.com. Keep it directly
# under the zone (one label): its HTTPS uses the zone's *.zone certificate.
PROBE_HOST_V4=
# Hostname reachable over IPv6 only: a DNS-only AAAA record pointing at a
# Cloudflare IPv6 address, e.g. probe-dev-6.example.com. Same rule as above.
PROBE_HOST_V6=

# Optional. Serve the page at / to browsers ("true", the default) or answer
# as an API only ("false").
PROBE_PAGE=
# Optional. Name shown in the page header and title (default: MyIP Probe).
PROBE_SITE_NAME=
# Optional. Google Analytics measurement id (G-…); without it the page loads
# no analytics.
PROBE_GA_ID=
# Optional. The page footer's "Full report" link (an https URL), or "off".
# Default: https://ipcheck.ing
PROBE_FULL_REPORT_URL=
# Optional. Show the "keeps no logs and runs no analytics" line ("true" /
# "false"). Default: shown only without PROBE_GA_ID. Set "false" when the
# deployment records requests in any other way.
PROBE_PRIVACY_NOTE=
# Optional. Origins allowed to read the API from a browser, comma-separated
# (https://app.example.com), or * for any. The probe's own hostnames are
# always allowed.
PROBE_ALLOWED_ORIGINS=
# Optional. Domains whose https origins (the domain and every subdomain) may
# read the API, comma-separated, e.g. example.com
PROBE_ALLOWED_ROOT_DOMAINS=
# Optional. The "note" line of the legacy /geo answer.
PROBE_LEGACY_NOTE=
